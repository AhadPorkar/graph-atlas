{
  "openapi": "3.1.0",
  "info": {
    "title": "Graph Atlas - Administrative API",
    "version": "0.5.0-preview",
    "description": "Spring Boot 4.1.1. JSON body schemas intentionally remain extensible for format-specific repository settings. See docs/en/api.md for exact fields and docs/en/coverage.md for protocol scope. Administrative error messages support en, de and fa through Accept-Language; English is the default. Machine error codes and package identifiers are not translated."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "basicAuth": []
    },
    {
      "bearerAuth": []
    },
    {
      "sessionAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque gr_ token"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gr_session"
      }
    },
    "schemas": {
      "AtlasAssetReference": {
        "type": "object",
        "required": [
          "repo",
          "path"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "AtlasCapture": {
        "type": "object",
        "required": [
          "name",
          "version",
          "assets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "maxLength": 100
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/AtlasAssetReference"
            }
          }
        }
      },
      "AtlasDecision": {
        "type": "object",
        "required": [
          "expectedRevision",
          "note"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "AtlasHold": {
        "type": "object",
        "required": [
          "sha256",
          "active",
          "reason",
          "expectedRevision"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "active": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AtlasGate": {
        "type": "object",
        "required": [
          "releaseId",
          "state",
          "revision",
          "deep",
          "allowed",
          "integrityOk",
          "signatureValid",
          "problems",
          "pointInTime"
        ],
        "properties": {
          "releaseId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "IN_REVIEW",
              "APPROVED",
              "RELEASED",
              "REJECTED",
              "REVOKED"
            ]
          },
          "revision": {
            "type": "integer"
          },
          "deep": {
            "type": "boolean"
          },
          "allowed": {
            "type": "boolean"
          },
          "integrityOk": {
            "type": "boolean"
          },
          "signatureValid": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "checkedDigests": {
            "type": "integer"
          },
          "sourceDrift": {
            "type": "integer"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "pointInTime": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/api/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Password login; a matching Origin header is mandatory",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission, Origin or CSRF check failed"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required with browser-session authentication. Origin must also exactly match graph.public-url."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
