GR_HOME=/var/lib/graph-repository
GR_BIND=127.0.0.1
GR_PORT=8081
GR_PUBLIC_URL=https://repo.example.com
GR_COOKIE_SECURE=true
GR_ALLOW_PRIVATE_UPSTREAM=false
GR_ALLOW_HTTP_UPSTREAM=false
GR_MAX_UPLOAD_BYTES=0
GR_MAX_JSON_BYTES=67108864
GR_CONCURRENT_REQUESTS=0
GR_MAX_CONNECTIONS=-1
GR_LOGIN_FAILURE_LIMIT=10
GR_LOGIN_FAILURE_WINDOW=60s
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
