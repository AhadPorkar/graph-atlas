# Docker Compose reads this file. run.sh does NOT execute or import .env files.
# For a public HTTPS deployment set the exact origin and enable secure cookies.
GR_PUBLIC_URL=http://localhost:8081
GR_COOKIE_SECURE=false
GR_ALLOW_PRIVATE_UPSTREAM=false
GR_ALLOW_HTTP_UPSTREAM=false
GR_MAX_UPLOAD_BYTES=0
GR_MAX_JSON_BYTES=67108864
GR_CONCURRENT_REQUESTS=0
GR_MAX_CONNECTIONS=-1
GR_LOGIN_FAILURE_LIMIT=10
GR_LOGIN_FAILURE_WINDOW=60s
# Leave empty to generate a unique admin password at first startup.
GR_BOOTSTRAP_PASSWORD=
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
